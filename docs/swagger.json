{
    "swagger": "2.0",
    "info": {
        "description": "REST API for crowdfunding campaigns and donations.",
        "title": "Crowdfunding API",
        "contact": {},
        "license": {
            "name": "MIT"
        },
        "version": "1.0"
    },
