# Application
APP_PORT=8080

# Host ports published by docker compose. Override these if 5432/8080 are
# already taken on your machine (e.g. a local Postgres), e.g. HOST_DB_PORT=5433.
HOST_DB_PORT=5432
HOST_APP_PORT=8080

# Database (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=crowdfunding
# Use "disable" locally; managed providers like Neon require "require".
DB_SSLMODE=disable

# Auth
JWT_SECRET_KEY=change_me

# Midtrans payment gateway
MIDTRANS_SERVER_KEY=your_server_key
MIDTRANS_CLIENT_KEY=your_client_key
# Turn the live checkout on/off. When false (the default) the web app shows a
# "contact support to enable a live demo" modal instead of creating a payment.
# Needs both keys above to actually take effect.
MIDTRANS_ENABLED=false

# Shown to visitors when a feature (e.g. payments) is in demo mode so they can
# request access.
SUPPORT_EMAIL=hi@wikukarno.dev

# Cloudflare R2 object storage (S3-compatible) for file uploads.
# Leave these empty to fall back to local disk during development.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL the uploaded files are served from (r2.dev URL or custom domain).
R2_PUBLIC_URL=
